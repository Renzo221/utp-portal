        </tr>
        <tr>
          <td>2025 - Ciclo 2</td>
          <td>100000N09I</td>
          <td>ESTADÍSTICA DESCRIPTIVA Y PROBABILIDADES</td>
          <td>1</td>
          <td>2.00</td>
          <td>18</td>
