<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>UTP Portal - Inicio Sesión</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      background: #fff;
      color: #000;
    }
    .logo {
      font-weight: bold;
      font-size: 28px;
      margin-bottom: 20px;
    }
    .logo span {
      background-color: black;
      color: white;
      padding: 6px 8px;
      margin-right: 3px;
      font-family: monospace;
    }
    .logo .plus {
      color: #ef2d51;
      margin-right: 6px;
      font-weight: bold;
      font-size: 28px;
    }
    h1 {
      font-size: 24px;
    }
    form {
      max-width: 400px;
      margin-top: 20px;
    }
    label {
      font-weight: 700;
      display: block;
      margin-top: 15px;
      margin-bottom: 6px;
    }
    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 8px 12px;
      font-size: 16px;
      border: 1.5px solid #aaa;
      border-radius: 4px;
      box-sizing: border-box;
    }
    .field-info {
      font-size: 13px;
      color: #555;
      margin-top: 4px;
    }
    .show-password {
      float: right;
      margin-top: -30px;
      margin-right: 10px;
      cursor: pointer;
      font-size: 20px;
      color: #555;
      user-select: none;
    }
    .reset-password {
      display: block;
      margin-top: 14px;
      color: #5a28f7;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }
    button {
      margin-top: 25px;
      background-color: #c9d7e6;
      color: #7a87a1;
      border: none;
      padding: 12px 0;
      width: 100%;
      font-weight: 700;
      font-size: 18px;
      border-radius: 6px;
      cursor: pointer;
    }
    .error-message {
      color: red;
      margin-top: 15px;
      font-weight: 600;
      display: none;
    }
    /* Estilos record de notas oculto inicialmente */
    #recordNotas {
      display: none;
      margin-top: 20px;
      background-color: #eaf1f8;
      padding: 20px;
      border-radius: 10px;
      max-width: 700px;
    }
    #recordNotas h2 {
      font-weight: 700;
      margin-bottom: 20px;
    }
    #recordNotas .card {
      background: white;
      border-radius: 10px;
      padding: 15px 18px;
      box-shadow: 0 1px 4px rgb(0 0 0 / 0.1);
      margin-bottom: 20px;
    }
    #recordNotas .card p {
      margin: 3px 0;
      font-size: 15px;
    }
    #recordNotas .download-button {
      border: 1.5px solid #5a28f7;
      color: #5a28f7;
      font-weight: 600;
      border-radius: 7px;
      padding: 8px 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      user-select: none;
      font-size: 15px;
      margin-bottom: 20px;
      background: transparent;
    }
    #recordNotas .download-button:hover {
      background: #5a28f7;
      color: #fff;
    }
    #recordNotas table {
      border-collapse: collapse;
      width: 100%;
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgb(0 0 0 / 0.1);
    }
    #recordNotas thead {
      background: #f0f0f7;
      color: #555;
      font-weight: 600;
      font-size: 14px;
    }
    #recordNotas th, #recordNotas td {
      padding: 12px 10px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }
    #recordNotas tr:last-child td {
      border-bottom: none;
    }
    #recordNotas .status {
      padding: 5px 10px;
      border-radius: 15px;
      color: white;
      font-weight: 600;
      display: inline-block;
      font-size: 13px;
      background-color: #216e3a;
    }
  </style>
</head>
<body>
  <!-- Login form -->
  <div id="loginSection">
    <div class="logo">
      <span>U</span><span>T</span><span>P</span><span class="plus">+</span>portal
    </div>

    <h1>¡Hola!</h1>
    <p>Ingresa tus datos para <strong>iniciar sesión</strong>.</p>

    <form id="loginForm">
      <label for="usuario">Usuario: código de alumno UTP</label>
      <input type="text" id="usuario" name="usuario" placeholder="Ingresa tu código UTP" required />
      <div class="field-info">Ejemplo de usuario: U1533148 (no digitar el @utp.edu.pe)</div>

      <label for="contraseña">Contraseña</label>
      <input type="password" id="contraseña" name="contraseña" placeholder="Ingresa tu contraseña" required />
      <span class="show-password" onclick="togglePassword()">👁️</span>

      <a href="#" class="reset-password">Restablecer contraseña</a>

      <button type="submit">Iniciar sesión</button>
      <div class="error-message" id="errorMsg">Usuario o contraseña incorrectos.</div>
    </form>
  </div>

