          <td>8006</td>
          <td><span class="status">Aprobado</span></td>
        </tr>
        <tr>
          <td>2025 - Ciclo 2</td>
          <td>100000N01I</td>
          <td>COMPRENSIÓN Y REDACCIÓN DE TEXTOS Il</td>
